--- a/.github/workflows/compose.yml
+++ b/.github/workflows/compose.yml
@@ -18,0 +19,3 @@
+      # Baked into the image's labels (compose.yaml build arguments; #235). Empty on a pull request.
+      GIT_COMMIT: ${{ github.sha }}
+      BUILD_DATE: ${{ github.event.head_commit.timestamp }}
@@ -115,0 +119,33 @@
+
+      # Only a push to main saves the image, right after the tests that ran against it (before the second start,
+      # which builds again): the publish workflow (publish.yml) pushes exactly this one.
+      - name: Check the tested image's files, as the image job does
+        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
+        shell: bash
+        run: |
+          id="$(docker create socboard-stack:local)"
+          mkdir -p "$RUNNER_TEMP/image-files"
+          docker export "$id" | tar -x -C "$RUNNER_TEMP/image-files" app
+          docker rm "$id" > /dev/null
+          python3 scripts/check_image_files.py "$RUNNER_TEMP/image-files"
+
+      - name: Save the tested image for the publish workflow
+        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
+        shell: bash
+        run: |
+          docker save socboard-stack:local | gzip -1 > "$RUNNER_TEMP/tested-image.tar.gz"
+          docker image inspect --format '{{.Id}}' socboard-stack:local > "$RUNNER_TEMP/tested-image.id"
+          cat "$RUNNER_TEMP/tested-image.id"
+
+      - name: Keep the tested image for one day
+        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: tested-image
+          path: |
+            ${{ runner.temp }}/tested-image.tar.gz
+            ${{ runner.temp }}/tested-image.id
+          retention-days: 1
+          compression-level: 0
+          overwrite: true
+          if-no-files-found: error
