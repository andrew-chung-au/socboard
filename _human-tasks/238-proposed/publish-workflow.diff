--- a/.github/workflows/publish.yml
+++ b/.github/workflows/publish.yml
@@ -181,0 +182,18 @@
+
+      # For the deploy workflow (#238): the digest this job pushed and pulled back, as an artifact a later
+      # workflow can read (a job output cannot be). Only reached when every step above passed.
+      - name: Write the published image for the deploy workflow
+        env:
+          DIGEST: ${{ steps.push.outputs.digest }}
+        run: |
+          jq -n --arg image "$IMAGE" --arg tag "$TAG" --arg digest "$DIGEST" --arg revision "$SHA" \
+            '{schema: 1, image: $image, tag: $tag, digest: $digest, revision: $revision}' > published-image.json
+          cat published-image.json
+
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: published-image
+          path: published-image.json
+          retention-days: 7
+          overwrite: true
+          if-no-files-found: error
