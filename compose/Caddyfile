# Local proxy of the Compose stack (#221): plain HTTP, no certificate, no admin endpoint.
# The deployed Caddy configuration, with TLS, is D17c's. Caddy sets X-Forwarded-For to the client's
# address and drops one sent by the caller (VERIFY: in D12, by sending a forged one).
{
	admin off
	auto_https off
}

:80 {
	reverse_proxy app:8000
}
