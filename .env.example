# SOCBoard runtime variables: names and rules only, never values.
# The list is socboard/settings.py; README.md ("Runtime variables") has the same table.
# Copy the names into your own git-ignored env file or secret store and fill them in there.
# Delete a line you leave empty: an empty value counts as set (an empty SOCBOARD_HOST is refused).

# Secret. At least 32 characters, not counting leading and trailing spaces, in every mode.
# In deployed mode also not one repeated character, whitespace ignored.
SOCBOARD_TOKEN_SECRET=

# Secret. At least 12 characters each. Read by make seed only; it needs all three on every run.
SOCBOARD_SEED_PASSWORD_ANALYST_A=
SOCBOARD_SEED_PASSWORD_ANALYST_B=
SOCBOARD_SEED_PASSWORD_LEAD=

# Secret. At least 16 characters; without it ingest is closed. In deployed mode required:
# at least 16 characters, no leading or trailing whitespace, and not one repeated character
# (whitespace ignored).
SOCBOARD_INGEST_API_KEY=

# Secret (it can hold a database password). A valid database URL; the default is socboard.db in
# the repository root. Required in deployed mode.
SOCBOARD_DATABASE_URL=

# Failed logins allowed per client address and username within the window (default 5).
SOCBOARD_LOGIN_MAX_FAILURES=

# Failed logins allowed per client address, across usernames, within the window (default 20).
SOCBOARD_LOGIN_CLIENT_MAX_FAILURES=

# The window in seconds (default 300). Whole numbers of 1 or more; counters live in the process.
SOCBOARD_LOGIN_WINDOW_SECONDS=

# The most counters kept at once, least recently failed dropped first (default 10000).
SOCBOARD_LOGIN_MAX_TRACKED=

# Comma-separated IP addresses of reverse proxies whose X-Forwarded-For is believed (default none).
SOCBOARD_TRUSTED_PROXIES=

# 127.0.0.1, localhost or ::1 (default 127.0.0.1).
SOCBOARD_HOST=

# A whole number from 1 to 65535 (default 8000).
SOCBOARD_PORT=

# The built frontend folder (default frontend/dist).
SOCBOARD_STATIC_DIR=

# Exactly the word deployed turns deployed mode on; any other value, or none, leaves it off.
SOCBOARD_MODE=
