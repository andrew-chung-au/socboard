#!/bin/bash
# The host bootstrap of the socboard server (issue #233, Deploy item D17c; hardened in #256). Terraform
# renders this file into the instance's user data (main.tf); cloud-init runs it once per instance, as
# root, at the first boot. A shell script rather than cloud-config: every step carries its own check,
# so the same file can be re-run by hand and the order (packages, then the volume, then Caddy) is
# plain to read.
#
# Idempotent: a second run on the same host changes nothing. Packages are installed only when
# missing (never upgraded here; Ubuntu's unattended upgrades patch them), a file is replaced only
# when its content differs, the volume is formatted only when it holds no signature at all, the
# fstab line is added only when the mount point has none, an owner or mode is set only when it
# differs, and a service restarts only when one of its files changed. Any failed write stops the
# script. Re-run by hand: sudo bash /var/lib/cloud/instance/scripts/part-001
# (VERIFY: the path cloud-init keeps it at on noble).
#
# Never held: this file holds no secret, writes none and reads none. It makes no Secrets Manager
# call (the instance role may read the one application secret; this script does not), and it does
# not deliver compose.yaml, the environment file or the deploy script: D20 does.
#
# What it assumes of the Compose file (D11, D20): the services that must come back after a reboot
# carry a restart policy (for example `restart: unless-stopped`); this script only makes Docker
# itself start at boot. The compose `proxy` service is not started on this host: Caddy below is
# the one proxy (issue #233, decision option 1).
set -eu
export DEBIAN_FRONTEND=noninteractive

# The data volume's mount point. Two siblings on it (#256): PG_DIR is STACK_PGDATA_DIR on this host
# (Postgres keeps its files in its `pgdata` subdirectory), and CADDY_DIR holds Caddy's certificates
# and account, outside anything a container mounts.
DATA_DIR='${data_dir}'
PG_DIR='${data_dir}/postgres'
CADDY_DIR='${data_dir}/caddy'
# The data volume by its NVMe serial, which is the volume id: a stable name, not a guessed device
# (#199 attaches it as /dev/sdf, which shows as an NVMe device on a Nitro instance).
# VERIFY: udev on noble makes this link for an EBS volume.
DATA_DEV='${data_device}'

# Caddy's apt repository (the vendor's, on Cloudsmith) and the fingerprint of its signing key.
# The keyring is refused unless it holds exactly one primary key, with exactly this fingerprint.
# VERIFY: the repository serves this key (the fingerprint was read from keyserver.ubuntu.com on
# 2026-11-15, user id "Caddy Web Server", not from Cloudsmith).
CADDY_REPO='https://dl.cloudsmith.io/public/caddy/stable'
CADDY_KEY_FPR='65760C51EDEA2017CEA2CA15155B6D79CA56EA34'
CADDY_KEYRING='/usr/share/keyrings/caddy-stable-archive-keyring.gpg'

say() { echo "socboard-bootstrap: $*"; }

# put PATH MODE: write standard input to PATH when it differs. Returns 0 when the file changed,
# 1 when it was already the same and 2 when the write failed.
put() {
  local tmp
  tmp=$(mktemp) || return 2
  if ! cat >"$tmp"; then
    rm -f "$tmp"
    return 2
  fi
  if [ -f "$1" ] && cmp -s "$tmp" "$1"; then
    rm -f "$tmp"
    return 1
  fi
  if ! install -D -m "$2" "$tmp" "$1"; then
    rm -f "$tmp"
    return 2
  fi
  rm -f "$tmp"
  say "wrote $1"
}

# write PATH MODE: put, and the only way this script calls it. Stops the script when the write
# failed; otherwise sets changed=1 when the file changed and changed=0 when it was the same.
write() {
  local rc=0
  put "$@" || rc=$?
  case "$rc" in
    0) changed=1 ;;
    1) changed=0 ;;
    *)
      say "could not write $1; stopping"
      exit 1
      ;;
  esac
}

# caddy_key_ok KEYRING: true only when KEYRING holds exactly one primary key (one `pub` record; its
# subkeys are allowed) and that key's fingerprint is CADDY_KEY_FPR. Any other shape prints what it
# found and fails: the rule accepts one known shape rather than listing bad ones.
caddy_key_ok() {
  local home recs found
  home=$(mktemp -d) || return 1
  if recs=$(gpg --homedir "$home" --show-keys --with-colons "$1" 2>/dev/null); then
    # The fingerprint record right after each `pub` record: one line per primary key.
    found=$(printf '%s\n' "$recs" | awk -F: '$1 == "pub" { p = 1 } $1 == "sub" { p = 0 } $1 == "fpr" && p { print $10; p = 0 }')
  else
    found='a file gpg cannot read'
  fi
  rm -rf "$home"
  if [ "$found" = "$CADDY_KEY_FPR" ]; then return 0; fi
  say "the Caddy keyring must hold exactly one primary key, $CADDY_KEY_FPR; found: [$(printf '%s' "$found" | tr '\n' ' ')]"
  return 1
}

# --- Docker's log rotation, written before Docker is installed so its first start uses it ---------
# 10 MB per file, 3 files per container. Applies to containers created after the change.
write /etc/docker/daemon.json 0644 <<'EOF'
{
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "3" }
}
EOF
if [ "$changed" = 1 ] && systemctl is-active -q docker; then systemctl restart docker; fi

# --- Caddy's repository ---------------------------------------------------------------------------
if [ ! -s "$CADDY_KEYRING" ]; then
  gnupghome=$(mktemp -d)
  curl -fsSL "$CADDY_REPO/gpg.key" | gpg --homedir "$gnupghome" --dearmor >"$CADDY_KEYRING.new"
  rm -rf "$gnupghome"
  if ! caddy_key_ok "$CADDY_KEYRING.new"; then
    rm -f "$CADDY_KEYRING.new"
    say "refusing the Caddy signing key; stopping"
    exit 1
  fi
  mv "$CADDY_KEYRING.new" "$CADDY_KEYRING"
  chmod 0644 "$CADDY_KEYRING"
fi
write /etc/apt/sources.list.d/caddy-stable.list 0644 <<EOF
deb [signed-by=$CADDY_KEYRING] $CADDY_REPO/deb/debian any-version main
EOF

# --- Packages ---------------------------------------------------------------------------------------
# docker.io and docker-compose-v2 (the Compose plugin) come from Ubuntu's own archive (noble
# universe), signed by the Ubuntu archive key the image already trusts
# (/usr/share/keyrings/ubuntu-archive-keyring.gpg). caddy comes from the vendor's repository above,
# because noble's own caddy is an old release. VERIFY: the three package names on noble.
missing=''
for p in docker.io docker-compose-v2 caddy; do
  dpkg-query -W -f '$${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' || missing="$missing $p"
done
if [ -n "$missing" ]; then
  apt-get update -q
  # shellcheck disable=SC2086
  apt-get install -y -q $missing
fi
systemctl enable --now docker

# --- Weekly image prune ---------------------------------------------------------------------------
# `docker image prune --all` removes only images no container uses, running or stopped, so an image
# a running container uses is never removed; `until=168h` also keeps anything pulled this week.
write /etc/cron.d/socboard-docker-prune 0644 <<'EOF'
# socboard (#233): weekly removal of images no container uses, older than 7 days.
23 4 * * 0 root /usr/bin/docker image prune --all --force --filter until=168h >/dev/null
EOF

# --- The data volume ----------------------------------------------------------------------------------
# Terraform attaches the volume after the instance is running, so wait up to 10 minutes for it.
for _ in $(seq 60); do
  [ -e "$DATA_DEV" ] && break
  sleep 10
done
if [ ! -e "$DATA_DEV" ]; then
  say "the data volume $DATA_DEV is not attached after 10 minutes; re-run this script once it is"
  exit 1
fi

# Formats only a device with no signature at all: blkid -p exits 2 when it finds none. Any other
# answer but 0 (a file system or partition table found) stops, so a volume with data is never
# formatted. On a replaced instance the volume already holds ext4: blkid exits 0, nothing is formatted.
rc=0
blkid -p "$DATA_DEV" >/dev/null || rc=$?
if [ "$rc" -eq 2 ]; then
  say "formatting the empty data volume"
  mkfs.ext4 -q -L socboard-data "$DATA_DEV"
elif [ "$rc" -ne 0 ]; then
  say "blkid could not read $DATA_DEV (exit $rc); not formatting, stopping"
  exit 1
fi

uuid=$(blkid -s UUID -o value "$DATA_DEV")
if [ -z "$uuid" ]; then
  say "the data volume has no file-system UUID; stopping"
  exit 1
fi
# By UUID, with nofail: a missing volume does not stop the boot (the wait for it is 30 seconds);
# the drop-ins below keep Docker and Caddy stopped instead.
if ! awk -v d="$DATA_DIR" '$2 == d { found = 1 } END { exit !found }' /etc/fstab; then
  echo "UUID=$uuid $DATA_DIR ext4 defaults,nofail,x-systemd.device-timeout=30s 0 2" >>/etc/fstab
  systemctl daemon-reload
  say "added the data volume to /etc/fstab"
fi

mkdir -p "$DATA_DIR"
if ! mountpoint -q "$DATA_DIR"; then
  # The bare directory is made immutable, so while the volume is not mounted nothing (Postgres
  # starting on the root disk, say) can write into it, and neither directory below can be made there.
  chattr +i "$DATA_DIR"
  mount "$DATA_DIR"
fi
if ! mountpoint -q "$DATA_DIR"; then
  say "the data volume is not mounted at $DATA_DIR; stopping"
  exit 1
fi

# Docker does not start without the volume, so no container (Postgres, say) runs with its data on
# the root disk. Written only now, once the fstab line exists and the volume is mounted: the mount
# unit it names is then loaded and active, so the daemon-reload accepts it and the Docker already
# running (started by the package install above) is unaffected; it applies from the next start.
write /etc/systemd/system/docker.service.d/socboard.conf 0644 <<'EOF'
[Unit]
RequiresMountsFor=${data_dir}
EOF
if [ "$changed" = 1 ]; then systemctl daemon-reload; fi

# --- The layout on the volume ---------------------------------------------------------------------
# Set on every run, each only when it differs: #233's run left the mount root owned by 999, and a
# replaced instance's caddy user may have another uid. Nothing on the volume is moved or deleted.
caddy_uid=$(id -u caddy)
caddy_gid=$(id -g caddy)
if [ "$caddy_uid" = 999 ]; then
  say "the caddy user has uid 999, the Postgres container's; stopping"
  exit 1
fi
# own PATH UID:GID MODE: sets PATH's owner and mode (its top level only) when they differ.
own() {
  if [ "$(stat -c %u:%g "$1")" != "$2" ]; then
    chown "$2" "$1"
    say "owner of $1 set to $2"
  fi
  if [ "$(stat -c %a "$1")" != "$3" ]; then
    chmod "$3" "$1"
    say "mode of $1 set to $3"
  fi
}
own "$DATA_DIR" 0:0 755
[ -d "$PG_DIR" ] || mkdir -m 0700 "$PG_DIR"
# The postgres user of the official image (README, "Compose stack"). Top level only: a later run
# must not walk the database's files, and the image's uid is fixed.
own "$PG_DIR" 999:999 700
[ -d "$CADDY_DIR" ] || mkdir -m 0700 "$CADDY_DIR"
own "$CADDY_DIR" "$caddy_uid:$caddy_gid" 700
# Everything under Caddy's folder, recursively, so a new caddy uid can read its key and account.
# chown -R does not follow symbolic links.
stray=$(find "$CADDY_DIR" \( ! -user "$caddy_uid" -o ! -group "$caddy_gid" \) -print -quit)
if [ -n "$stray" ]; then
  chown -R "$caddy_uid:$caddy_gid" "$CADDY_DIR"
  say "owner of everything under $CADDY_DIR set to $caddy_uid:$caddy_gid"
fi
# --- end of the layout ----------------------------------------------------------------------------

# --- Caddy ----------------------------------------------------------------------------------------------
# Its data lives on the volume, so a replaced instance keeps its certificate and account.
restart_caddy=0
# Caddy does not start without the volume, so it never writes a certificate to the root disk.
write /etc/systemd/system/caddy.service.d/socboard.conf 0644 <<'EOF'
[Unit]
RequiresMountsFor=${data_dir}
EOF
if [ "$changed" = 1 ]; then
  systemctl daemon-reload
  restart_caddy=1
fi

# The hostname comes from the Elastic IP through the wildcard-DNS service (Deploy decision 6).
# No contact address: the certificate authority's account is made without one (decision 6: a real
# address or none). The admin endpoint is off, so the unit's reload cannot work: restart instead.
#
# Forwarded address: Caddy replaces any X-Forwarded-For the caller sent with the caller's address
# (it trusts no proxy before it). The app is published on the host's loopback only, so Caddy's
# connection reaches it through Docker's port publishing and the app sees the Compose network's
# gateway as the peer: 10.231.77.1 for the `stack` network of compose.yaml (subnet 10.231.77.0/24,
# gateway pinned there by #261).
# D20 sets SOCBOARD_TRUSTED_PROXIES to that address and leaves FORWARDED_ALLOW_IPS at its default.
# VERIFY: at D19b, the peer address the app logs for a request through Caddy.
write /etc/caddy/Caddyfile 0644 <<'EOF'
{
	admin off
	acme_ca ${acme_ca}
	storage file_system {
		root ${data_dir}/caddy
	}
}

${hostname} {
	reverse_proxy ${app_upstream}
}
EOF
if [ "$changed" = 1 ]; then restart_caddy=1; fi

systemctl enable --now caddy
if [ "$restart_caddy" = 1 ]; then systemctl restart caddy; fi
say "done"
