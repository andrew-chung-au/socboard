# What stays out of the image's build context (#190). The Dockerfile copies named paths only.
# tests/test_dockerfile.py checks that every entry is present.
.git
**/.git
.scratch
node_modules
**/node_modules
frontend/node_modules
frontend/dist

# Env files by name and by extension, except the example one.
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
!.env.example
!**/.env.example

# The Compose stack's local secrets (#221): `build: .` sends the folder as the build context.
compose.secrets

# Databases and their journal files.
*.db
**/*.db
*.db-journal
*.db-wal
*.db-shm
**/*.db-journal
**/*.db-wal
**/*.db-shm

tests
_docs
_session-summaries
_human-tasks
terraform
.github

.venv
**/__pycache__
.pytest_cache
.ruff_cache

# The browser test is not part of the image (#234).
e2e
